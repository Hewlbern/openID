# Solid pod (Go server)
SOLID_PORT=3000
SOLID_STORAGE_PATH=./data
# Public origin used in WebIDs. In production this must be the live pod URL,
# not localhost — e.g. https://pod-production-ebe1.up.railway.app
SOLID_BASE_URL=http://localhost:3000
# HMAC secret for Bearer tokens. Required in production.
SOLID_TOKEN_SECRET=change-me

# Optional audit
# IPFS_API=http://127.0.0.1:5001
# AUDIT_BATCH_INTERVAL=30s
# OTS_CALENDAR=

# Vercel frontend build (repo root or frontend/)
# Pod origin the Vercel site proxies to. Browser stays on the Vercel origin
# (same-origin /idp, /conversations, /share) so login cookies + Bearer work.
OPENID_POD=https://pod-production-ebe1.up.railway.app
# Leave unset so the baked config.js uses same-origin URLs.
# OPENID_API=
# Set OPENID_BROWSER_API=1 only if you want the browser to call the pod
# origin directly (cross-site). Same-origin proxy is the supported path.
# OPENID_BROWSER_API=1

# Password reset email. Leave unset to disable mail (the forgot-password
# form still returns a generic success and does not reveal accounts).
# Set ONE provider. OPENID_EMAIL_DIR is a dev/test sink only — never point
# it at the Solid storage volume.
# OPENID_EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# OPENID_EMAIL_FROM=AskClaw <noreply@askclaw.xyz>
# OPENID_EMAIL_PROVIDER=smtp
# OPENID_SMTP_HOST=
# OPENID_SMTP_PORT=587
# OPENID_SMTP_USER=
# OPENID_SMTP_PASSWORD=
# OPENID_EMAIL_FROM=noreply@askclaw.xyz
# OPENID_EMAIL_DIR=

# Operator recovery for accounts without a deliverable email (for example
# mike@localhost). Required on the Railway pod. Treat it like a root secret.
# OPENID_ADMIN_RESET_SECRET=
# Public site origin used in reset links. On Railway set this to the Vercel
# site so the link opens the reset page, not the pod host.
# OPENID_PUBLIC_URL=https://askclaw.xyz
