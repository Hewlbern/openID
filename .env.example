# Solid pod (Go server)
SOLID_PORT=3000
SOLID_STORAGE_PATH=./data
# Public origin used in WebIDs. In production this must be the live pod URL,
# not localhost — e.g. https://pod-production-ebe1.up.railway.app
SOLID_BASE_URL=http://localhost:3000
# HMAC secret for Bearer tokens. Required in production.
SOLID_TOKEN_SECRET=change-me

# Optional audit
# IPFS_API=http://127.0.0.1:5001
# AUDIT_BATCH_INTERVAL=30s
# OTS_CALENDAR=

# Vercel frontend build (repo root or frontend/)
# Pod origin the Vercel site proxies to. Browser stays on the Vercel origin
# (same-origin /idp, /conversations, /share) so login cookies + Bearer work.
OPENID_POD=https://pod-production-ebe1.up.railway.app
# Leave unset so the baked config.js uses same-origin URLs.
# OPENID_API=
# Set OPENID_BROWSER_API=1 only if you want the browser to call the pod
# origin directly (cross-site). Same-origin proxy is the supported path.
# OPENID_BROWSER_API=1

# Public passport origin used in copyable agent prompts (defaults to the request host).
# OPENID_PUBLIC_URL=https://askclaw.xyz
# Short-lived agent JWT lifetime in seconds (default 7200 = 2 hours).
# OPENID_AGENT_TOKEN_TTL=7200

# Google sign-in (new Web OAuth client for askclaw — do not reuse megabot's Supabase client).
# Authorized JS origins: https://askclaw.xyz , https://identity-two-plum.vercel.app , http://localhost:3000
# Redirect URIs: https://askclaw.xyz/api/auth/google/callback
#                https://identity-two-plum.vercel.app/api/auth/google/callback
#                http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional override if the callback host is not the request host:
# GOOGLE_REDIRECT_URI=https://askclaw.xyz/api/auth/google/callback
# Railway also needs GOOGLE_CLIENT_ID so POST /idp/google can check the ID token audience.
