{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oid",
  "version": "0.1.0",
  "identifier": "app.openid.desktop",
  "build": {
    "frontendDist": ".."
  },
  "app": {
    "windows": [
      {
        "title": "OpenID",
        "width": 760,
        "height": 560,
        "minWidth": 520,
        "minHeight": 400,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
