{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/dashboard", "destination": "/dash.html" },
    { "source": "/dashboard/", "destination": "/dash.html" },
    { "source": "/welcome", "destination": "/index.html" },
    { "source": "/welcome/", "destination": "/index.html" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/app/", "destination": "/app.html" },
    { "source": "/records", "destination": "/records.html" },
    { "source": "/records/", "destination": "/records.html" },
    { "source": "/login", "destination": "/dash.html" },
    { "source": "/idp/:path*", "destination": "https://pod-production-ebe1.up.railway.app/idp/:path*" },
    { "source": "/oauth/:path*", "destination": "https://pod-production-ebe1.up.railway.app/oauth/:path*" },
    { "source": "/conversations", "destination": "https://pod-production-ebe1.up.railway.app/conversations" },
    { "source": "/conversations/:path*", "destination": "https://pod-production-ebe1.up.railway.app/conversations/:path*" },
    { "source": "/share/c/:path*", "destination": "https://pod-production-ebe1.up.railway.app/share/c/:path*" },
    { "source": "/mcp", "destination": "https://pod-production-ebe1.up.railway.app/mcp" },
    { "source": "/mcp/:path*", "destination": "https://pod-production-ebe1.up.railway.app/mcp/:path*" },
    { "source": "/agents", "destination": "https://pod-production-ebe1.up.railway.app/agents" },
    { "source": "/agents/:path*", "destination": "https://pod-production-ebe1.up.railway.app/agents/:path*" },
    { "source": "/audit/:path*", "destination": "https://pod-production-ebe1.up.railway.app/audit/:path*" },
    { "source": "/notifications/:path*", "destination": "https://pod-production-ebe1.up.railway.app/notifications/:path*" },
    { "source": "/health", "destination": "https://pod-production-ebe1.up.railway.app/health" },
    { "source": "/api/:path*", "destination": "https://pod-production-ebe1.up.railway.app/api/:path*" },
    { "source": "/.well-known/:path*", "destination": "https://pod-production-ebe1.up.railway.app/.well-known/:path*" },
    { "source": "/i/:path*", "destination": "https://pod-production-ebe1.up.railway.app/i/:path*" },
    { "source": "/:path*", "destination": "https://pod-production-ebe1.up.railway.app/:path*" }
  ]
}
